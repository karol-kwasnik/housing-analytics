-- 01 Prices ------------------------------------------------------------

Median Price sqm =
IF (
    HASONEVALUE ( dim_market_type[market_type] )
        && HASONEVALUE ( dim_size_range[size_range] ),
    MAX ( fact_market[median_price_sqm] )
)

National Median Price sqm =
MEDIANX ( VALUES ( dim_territory[teryt_code] ), [Median Price sqm] )

Avg Price sqm =
IF (
    HASONEVALUE ( dim_market_type[market_type] )
        && HASONEVALUE ( dim_size_range[size_range] ),
    MAX ( fact_market[avg_price_sqm] )
)

Selected Year = SELECTEDVALUE ( dim_date[year] )

Median Price sqm PY =
VAR PriorYear = [Selected Year] - 1
RETURN
    CALCULATE (
        [Median Price sqm],
        REMOVEFILTERS ( dim_date ),
        dim_date[year] = PriorYear
    )

National Median Price sqm PY =
VAR PriorYear = [Selected Year] - 1
RETURN
    CALCULATE (
        [National Median Price sqm],
        REMOVEFILTERS ( dim_date ),
        dim_date[year] = PriorYear
    )

Price sqm YoY % =
DIVIDE ( [Median Price sqm] - [Median Price sqm PY], [Median Price sqm PY] )

National Price sqm YoY % =
DIVIDE (
    [National Median Price sqm] - [National Median Price sqm PY],
    [National Median Price sqm PY]
)

Price sqm Change since 2010 % =
VAR BasePrice =
    CALCULATE (
        [National Median Price sqm],
        REMOVEFILTERS ( dim_date ),
        dim_date[year] = 2010
    )
RETURN
    DIVIDE ( [National Median Price sqm] - BasePrice, BasePrice )

Primary Market Premium % =
VAR PrimaryPrice =
    CALCULATE (
        MAX ( fact_market[median_price_sqm] ),
        dim_market_type[market_type] = "rynek pierwotny",
        dim_size_range[size_range] = "ogółem"
    )
VAR SecondaryPrice =
    CALCULATE (
        MAX ( fact_market[median_price_sqm] ),
        dim_market_type[market_type] = "rynek wtórny",
        dim_size_range[size_range] = "ogółem"
    )
RETURN
    DIVIDE ( PrimaryPrice - SecondaryPrice, SecondaryPrice )

-- 02 Market ------------------------------------------------------------

Dwellings Sold = SUM ( fact_market[dwellings_sold] )

Dwellings Sold PY =
VAR PriorYear = [Selected Year] - 1
RETURN
    CALCULATE ( [Dwellings Sold], REMOVEFILTERS ( dim_date ), dim_date[year] = PriorYear )

Dwellings Sold YoY % =
DIVIDE ( [Dwellings Sold] - [Dwellings Sold PY], [Dwellings Sold PY] )

Floor Area Sold = SUM ( fact_market[floor_area_sold] )

Share of National Market % =
DIVIDE (
    [Dwellings Sold],
    CALCULATE ( [Dwellings Sold], REMOVEFILTERS ( dim_territory ) )
)

Price Rank =
VAR Ranking =
    RANKX (
        ALLSELECTED ( dim_territory[teryt_code] ),
        CALCULATE ( [Median Price sqm] ),
        ,
        DESC,
        DENSE
    )
RETURN
    IF ( NOT ISBLANK ( [Median Price sqm] ), Ranking )

Population = SUM ( fact_context[population] )

Dwellings Completed = SUM ( fact_context[dwellings_completed] )

Dwellings per 1000 = AVERAGE ( fact_context[dwellings_per_1000] )

-- 03 Affordability -----------------------------------------------------

Net to Gross =
CALCULATE ( MAX ( param_credit[parameter_value] ), param_credit[parameter_name] = "net_to_gross" )

Bank Margin =
CALCULATE ( MAX ( param_credit[parameter_value] ), param_credit[parameter_name] = "bank_margin" )

Min Down Payment =
CALCULATE ( MAX ( param_credit[parameter_value] ), param_credit[parameter_name] = "min_down_payment" )

Gross Salary = AVERAGE ( fact_context[avg_gross_salary] )

Gross Salary PY =
VAR PriorYear = [Selected Year] - 1
RETURN
    CALCULATE ( [Gross Salary], REMOVEFILTERS ( dim_date ), dim_date[year] = PriorYear )

Salary YoY % = DIVIDE ( [Gross Salary] - [Gross Salary PY], [Gross Salary PY] )

Net Salary = [Gross Salary] * [Net to Gross]

Sqm per Monthly Salary = DIVIDE ( [Net Salary], [Median Price sqm] )

Years of Work =
DIVIDE ( [Median Price sqm] * [Floor Area Value], [Net Salary] * 12 )

Affordability Index =
DIVIDE (
    [Sqm per Monthly Salary],
    CALCULATE ( [Sqm per Monthly Salary], REMOVEFILTERS ( dim_territory ) )
) * 100

Median Salary Line =
MEDIANX ( VALUES ( dim_territory[teryt_code] ), [Gross Salary] )

Median Price Line =
MEDIANX ( VALUES ( dim_territory[teryt_code] ), [Median Price sqm] )

Price vs Salary Growth Ratio =
VAR PriceBase =
    CALCULATE ( [Median Price sqm], REMOVEFILTERS ( dim_date ), dim_date[year] = 2010 )
VAR SalaryBase =
    CALCULATE ( [Gross Salary], REMOVEFILTERS ( dim_date ), dim_date[year] = 2010 )
VAR PriceGrowth = DIVIDE ( [Median Price sqm], PriceBase )
VAR SalaryGrowth = DIVIDE ( [Gross Salary], SalaryBase )
RETURN
    DIVIDE ( PriceGrowth, SalaryGrowth )

-- 04 Simulator ---------------------------------------------------------

Rate Value = SELECTEDVALUE ( param_rate[rate], 0.0575 )

Down Payment Value = SELECTEDVALUE ( param_down_payment[down_payment], [Min Down Payment] )

Loan Years Value = SELECTEDVALUE ( param_loan_years[loan_years], 25 )

Floor Area Value = SELECTEDVALUE ( param_floor_area[floor_area], 50 )

Property Price = [Median Price sqm] * [Floor Area Value]

Loan Amount = [Property Price] * ( 1 - [Down Payment Value] )

Monthly Payment =
VAR Principal = [Loan Amount]
VAR MonthlyRate = DIVIDE ( [Rate Value] + [Bank Margin], 12 )
VAR Months = [Loan Years Value] * 12
RETURN
    IF (
        MonthlyRate > 0,
        DIVIDE (
            Principal * MonthlyRate,
            1 - POWER ( 1 + MonthlyRate, - Months )
        ),
        DIVIDE ( Principal, Months )
    )

Monthly Payment at Rate =
VAR Principal = [Loan Amount]
VAR MonthlyRate = DIVIDE ( MAX ( axis_rate[rate] ) + [Bank Margin], 12 )
VAR Months = [Loan Years Value] * 12
RETURN
    IF (
        MonthlyRate > 0,
        DIVIDE (
            Principal * MonthlyRate,
            1 - POWER ( 1 + MonthlyRate, - Months )
        ),
        DIVIDE ( Principal, Months )
    )

Payment to Income % = DIVIDE ( [Monthly Payment], [Net Salary] )

PTI Colour =
SWITCH (
    TRUE (),
    [Payment to Income %] > 0.50, "#D1495B",
    [Payment to Income %] > 0.35, "#E08A3C",
    "#3BA99C"
)

-- 05 Quality -----------------------------------------------------------

Completeness % =
DIVIDE ( COUNT ( fact_market[median_price_sqm] ), COUNTROWS ( fact_market ) )

Counties with Gaps =
COUNTROWS (
    FILTER (
        VALUES ( dim_territory[teryt_code] ),
        ISBLANK ( [Median Price sqm] )
    )
)

Small Sample Flag =
IF ( NOT ISBLANK ( [Dwellings Sold] ) && [Dwellings Sold] < 10, 1, 0 )

Reliability Label = SELECTEDVALUE ( dim_reliability[reliability] )

Rank Colour =
SWITCH (
    TRUE (),
    [Small Sample Flag] = 1, "#5A6472",
    [Years of Work] > 10,   "#D1495B",
    [Years of Work] < 5,    "#3BA99C",
    "#E8C547"
)
