-- 01 Prices ------------------------------------------------------------

Median Price sqm = AVERAGE ( fact_market[median_price_sqm] )

Avg Price sqm = AVERAGE ( fact_market[avg_price_sqm] )

Price sqm YoY % =
VAR CurrentPrice = [Median Price sqm]
VAR PreviousPrice =
    CALCULATE ( [Median Price sqm], SAMEPERIODLASTYEAR ( dim_date[full_date] ) )
RETURN
    DIVIDE ( CurrentPrice - PreviousPrice, PreviousPrice )

Price sqm Change since 2010 % =
VAR BasePrice =
    CALCULATE ( [Median Price sqm], REMOVEFILTERS ( dim_date ), dim_date[year] = 2010 )
RETURN
    DIVIDE ( [Median Price sqm] - BasePrice, BasePrice )

Primary Market Premium % =
VAR PrimaryPrice =
    CALCULATE ( [Median Price sqm], dim_market_type[market_type] = "rynek pierwotny" )
VAR SecondaryPrice =
    CALCULATE ( [Median Price sqm], dim_market_type[market_type] = "rynek wtórny" )
RETURN
    DIVIDE ( PrimaryPrice - SecondaryPrice, SecondaryPrice )

-- 02 Market ------------------------------------------------------------

Dwellings Sold = SUM ( fact_market[dwellings_sold] )

Floor Area Sold = SUM ( fact_market[floor_area_sold] )

Share of National Market % =
DIVIDE (
    [Dwellings Sold],
    CALCULATE ( [Dwellings Sold], REMOVEFILTERS ( dim_territory ) )
)

Price Rank =
VAR Ranking =
    RANKX (
        ALLSELECTED ( dim_territory[teryt_code] ),
        CALCULATE ( [Median Price sqm] ),
        ,
        DESC,
        DENSE
    )
RETURN
    IF ( NOT ISBLANK ( [Median Price sqm] ), Ranking )

Dwellings Completed = SUM ( fact_context[dwellings_completed] )

Population = SUM ( fact_context[population] )

-- 03 Affordability -----------------------------------------------------

Net to Gross =
CALCULATE ( MAX ( param_credit[parameter_value] ), param_credit[parameter_name] = "net_to_gross" )

Bank Margin =
CALCULATE ( MAX ( param_credit[parameter_value] ), param_credit[parameter_name] = "bank_margin" )

Min Down Payment =
CALCULATE ( MAX ( param_credit[parameter_value] ), param_credit[parameter_name] = "min_down_payment" )

Gross Salary = AVERAGE ( fact_context[avg_gross_salary] )

Net Salary = [Gross Salary] * [Net to Gross]

Sqm per Monthly Salary = DIVIDE ( [Net Salary], [Median Price sqm] )

Years of Work = DIVIDE ( [Median Price sqm] * [Floor Area Value], [Net Salary] * 12 )

Affordability Index =
DIVIDE (
    [Sqm per Monthly Salary],
    CALCULATE ( [Sqm per Monthly Salary], REMOVEFILTERS ( dim_territory ) )
) * 100

-- 04 Simulator ---------------------------------------------------------

Rate Value = SELECTEDVALUE ( param_rate[rate], 0.0575 )

Down Payment Value = SELECTEDVALUE ( param_down_payment[down_payment], [Min Down Payment] )

Loan Years Value = SELECTEDVALUE ( param_loan_years[loan_years], 25 )

Floor Area Value = SELECTEDVALUE ( param_floor_area[floor_area], 50 )

Property Price = [Median Price sqm] * [Floor Area Value]

Loan Amount = [Property Price] * ( 1 - [Down Payment Value] )

Monthly Payment =
VAR Principal = [Loan Amount]
VAR MonthlyRate = ( [Rate Value] + [Bank Margin] ) / 12
VAR Months = [Loan Years Value] * 12
RETURN
    IF (
        MonthlyRate > 0,
        DIVIDE (
            Principal * MonthlyRate * POWER ( 1 + MonthlyRate, Months ),
            POWER ( 1 + MonthlyRate, Months ) - 1
        ),
        DIVIDE ( Principal, Months )
    )

Payment to Income % = DIVIDE ( [Monthly Payment], [Net Salary] )

-- 05 Quality -----------------------------------------------------------

Completeness % =
DIVIDE ( COUNT ( fact_market[median_price_sqm] ), COUNTROWS ( fact_market ) )

Small Sample Warning =
IF (
    NOT ISBLANK ( [Dwellings Sold] ) && [Dwellings Sold] < 10,
    "Small sample - median unreliable",
    BLANK ()
)
