{
  "name": "Housing Dark",
  "dataColors": [
    "#E8A838", "#4EA3C7", "#3BA99C", "#D1495B", "#7FB069",
    "#E08A3C", "#E8C547", "#9BA3AF", "#B07AA1", "#6B8FB4"
  ],
  "good": "#3BA99C",
  "neutral": "#E8C547",
  "bad": "#D1495B",
  "maximum": "#D1495B",
  "center": "#E8C547",
  "minimum": "#3BA99C",
  "null": "#3F4753",
  "background": "#0E1116",
  "backgroundLight": "#161A21",
  "backgroundNeutral": "#1D222B",
  "foreground": "#E8EAED",
  "foregroundNeutralSecondary": "#9BA3AF",
  "foregroundNeutralTertiary": "#6B7280",
  "tableAccent": "#E8A838",
  "hyperlink": "#E8A838",
  "visitedHyperlink": "#F2C067",
  "textClasses": {
    "title": {
      "fontFace": "Georgia",
      "fontSize": 16,
      "color": "#E8EAED"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#E8EAED"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#9BA3AF"
    },
    "callout": {
      "fontFace": "Consolas",
      "fontSize": 26,
      "color": "#E8EAED"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#161A21" } }, "transparency": 0 }
        ],
        "border": [
          { "show": true, "color": { "solid": { "color": "#262D38" } }, "radius": 6 }
        ],
        "dropShadow": [ { "show": false } ],
        "visualHeader": [ { "show": false } ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#6B7280" } },
            "background": { "solid": { "color": "#161A21" } },
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "alignment": "left"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#6B7280" } },
            "fontFamily": "Consolas",
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": false,
            "lineColor": { "solid": { "color": "#262D38" } }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#6B7280" } },
            "fontFamily": "Consolas",
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#1D222B" } },
            "gridlineThickness": 1,
            "lineColor": { "solid": { "color": "#262D38" } }
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#E8EAED" } },
            "fontFamily": "Consolas",
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "showTitle": false,
            "labelColor": { "solid": { "color": "#9BA3AF" } },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "wordWrap": [ { "show": true } ]
      }
    },
    "page": {
      "*": {
        "background": [
          { "color": { "solid": { "color": "#0E1116" } }, "transparency": 0 }
        ],
        "outspace": [
          { "color": { "solid": { "color": "#0E1116" } } }
        ],
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#161A21" } },
            "foregroundColor": { "solid": { "color": "#E8EAED" } },
            "borderColor": { "solid": { "color": "#262D38" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#E8EAED" } },
            "fontFamily": "Consolas",
            "fontSize": 26
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#6B7280" } },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#161A21" } } }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#9BA3AF" } },
            "background": { "solid": { "color": "#161A21" } },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#6B7280" } },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#1D222B" } },
            "rowPadding": 4,
            "outlineColor": { "solid": { "color": "#262D38" } }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#6B7280" } },
            "backColor": { "solid": { "color": "#161A21" } },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#E8EAED" } },
            "backColorPrimary": { "solid": { "color": "#161A21" } },
            "fontColorSecondary": { "solid": { "color": "#E8EAED" } },
            "backColorSecondary": { "solid": { "color": "#1A1F27" } },
            "fontFamily": "Consolas",
            "fontSize": 10
          }
        ]
      }
    }
  }
}
