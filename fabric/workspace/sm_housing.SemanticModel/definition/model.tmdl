ref table dim_territory
ref table dim_market_type
ref table dim_size_range
ref table dim_reliability
ref table fact_market
ref table fact_context
ref table param_credit
ref table param_rate
ref table param_down_payment
ref table param_loan_years
ref table param_floor_area
ref table _measures

